<?xml version="1.0" encoding="utf-8"?>
<!--
    信息修改界面：
      ScrollView
        └ LinearLayout 竖向
             ├ 标题栏（信息修改）
             ├ 头像选择区
             ├ 姓名 / 学号 输入框
             ├ 性别 单选（男 / 女）
             ├ 爱好 多选（阅读 / 游戏 / 购物）
             ├ 电话 / 邮件 输入框
             └ 保存 / 取消 按钮
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- 标题栏 -->
        <LinearLayout
            android:id="@+id/header_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_primary"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_l"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- 头像 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_label_avatar"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_s"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/cd_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- 姓名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/edit_label_name"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_card_surface"
                android:hint="@string/edit_hint_name"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <!-- 学号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/edit_label_student_id"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints=""
                android:background="@drawable/bg_card_surface"
                android:hint="@string/edit_hint_student_id"
                android:inputType="number"
                android:minHeight="48dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <!-- 性别 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/edit_label_gender"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_male"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/edit_gender_male"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rb_female"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/edit_gender_female"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <!-- 爱好 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/edit_label_hobbies"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_reading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/edit_hobby_reading"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <CheckBox
                    android:id="@+id/cb_game"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/edit_hobby_game"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <CheckBox
                    android:id="@+id/cb_shopping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/edit_hobby_shopping"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- 电话 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/edit_label_phone"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="phone"
                android:background="@drawable/bg_card_surface"
                android:hint="@string/edit_hint_phone"
                android:inputType="phone"
                android:minHeight="48dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <!-- 邮件 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/edit_label_email"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_card_surface"
                android:hint="@string/edit_hint_email"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 保存 / 取消 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_l"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/edit_btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="@string/edit_btn_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
