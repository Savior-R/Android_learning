<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 实验三：CameraActivity 隐式调用系统相机拍照所需的权限 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Android 11 (API 30) 及以上引入了包可见性限制：
      隐式 Intent 只有在 <queries> 中声明了目标动作，系统才能把对应的相机应用匹配出来，
      否则 resolveActivity() 会返回 null。这里声明 IMAGE_CAPTURE 动作即可。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiActivity">

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 二级 Activity ①：接收 MainActivity 正向传递的参数 -->
        <activity
            android:name=".ParamActivity"
            android:exported="false"
            android:label="@string/param_title" />

        <!-- 二级 Activity ②：输入内容并回传结果给 MainActivity -->
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:label="@string/result_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 二级 Activity ③：隐式 Intent 启动系统相机拍照并显示照片 -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="@string/camera_title" />

        <!-- 二级 Activity ④：StopWatch 计时器（横竖屏连续计时，故不声明 configChanges） -->
        <activity
            android:name=".StopWatchActivity"
            android:exported="false"
            android:label="@string/stopwatch_title" />
    </application>

</manifest>
