<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面：
      LinearLayout 竖向
        ├ Toolbar（应用标题 = 姓名+学号）
        ├ RecyclerView  歌曲列表（ContentResolver 读媒体库）
        └ 控制面板      当前歌名 + 时间 + SeekBar + 上一首/播放/下一首/停止
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:elevation="2dp"
        app:titleTextColor="@color/white" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_s"
        android:scrollbars="none" />

    <!-- 底部控制面板 -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_m">

        <TextView
            android:id="@+id/tv_current_song"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/main_no_song"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0:00 / 0:00"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="@string/cd_prev"
                android:padding="12dp"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/cd_play_pause"
                android:padding="14dp"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="@string/cd_next"
                android:padding="12dp"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/btn_stop"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="@string/cd_stop"
                android:padding="14dp"
                android:src="@drawable/ic_stop" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
