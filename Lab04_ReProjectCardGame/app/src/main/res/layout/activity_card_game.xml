<?xml version="1.0" encoding="utf-8"?>
<!--
    翻牌游戏界面（View 层）
    结构：
      根 LinearLayout 竖向
        ├ 顶部栏：标题 + 得分 + [重置游戏] [退出]
        └ GridLayout（4 列）：牌的卡片由 Controller 动态生成并塞进来
    牌本身不写死在 XML 里，因为一局要发多少张、发哪些牌都由 Model 决定，
    View 只负责提供"容器 + 统计信息显示"。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/header_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_score"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:text="@string/game_btn_reset"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:text="@string/game_btn_exit"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 牌桌 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_m">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/grid_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:columnCount="4"
            android:useDefaultMargins="false" />
    </FrameLayout>
</LinearLayout>
